{
  "hosting": {
    "public": "dist/login",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "masmetrica-backend",
          "region": "europe-southwest1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}